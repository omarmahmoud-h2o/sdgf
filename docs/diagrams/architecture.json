  "cards": [
    {
      "dot": "cyan",
      "title": "Validation layers",
      "items": [
        "L1 schema, L2 label_rule + hooks: repairable",
        "L3 governance (PII, secrets) and L4 overlap: hard drop",
        "L5 blind judge, L6 K-vote consistency on escalations",
        "fail_repairable re-prompts the same recipe ≤ repair_tries"
      ]
    },
    {
      "dot": "amber",
      "title": "Gate and refill",
      "items": [
        "Fidelity, κ, coverage, balance, diversity, overlap, cost, yield",
        "Unmeasured thresholded metric fails unless waived",
        "Fail: shortfall report, refill short cells ≤ max_rounds",
        "Governance violations can't be waived"
      ]
    },
    {
      "dot": "violet",
      "title": "Supporting components",
      "items": [
        "Tool gateway: allowlist, budgets, cache, sensitivity labels",
        "HITL: plan approval (exit 3), review queue, gold set",
        "Judge calibration: trusted only if κ and ECE pass",
        "Task types: classification_spans, sft_qa"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and provenance",
      "items": [
        "API keys only via api_key_env",
        "Held-out paths passed at run time, never saved",
        "Every record carries _provenance per layer attempt",
        "governance_report lists external endpoints"
      ]
    }
  ]
